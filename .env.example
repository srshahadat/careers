# Admin login password (choose your own strong password)
ADMIN_PASSWORD=change-this-password

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-random-secret

# The following are auto-added to your Vercel project when you
# connect Vercel Postgres and Vercel Blob from the dashboard —
# you normally do NOT need to set these manually.
# POSTGRES_URL=...
# BLOB_READ_WRITE_TOKEN=...
